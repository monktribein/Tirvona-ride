# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
# 5000 is used by Newbackend; Tirvona Rides runs beside it on 5100.
PORT=5100
LOG_LEVEL=debug
SWAGGER_ENABLED=true
TRUST_PROXY=false

# Comma-separated. The ride admin panel runs on 5180 in development.
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# ─── Rate limiting ──────────────────────────────────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
# Phase 7: stricter per-route limits (per client IP, per route)
THROTTLE_AUTH_LIMIT=10
THROTTLE_AUTH_TTL_MS=60000
THROTTLE_OTP_SEND_LIMIT=3
THROTTLE_OTP_SEND_TTL_MS=600000
THROTTLE_OTP_VERIFY_LIMIT=10
THROTTLE_OTP_VERIFY_TTL_MS=600000
# Signup (each one sends a paid WhatsApp message), per client IP
THROTTLE_SIGNUP_LIMIT=10
THROTTLE_SIGNUP_TTL_MS=600000
THROTTLE_REFRESH_LIMIT=30
THROTTLE_REFRESH_TTL_MS=60000
THROTTLE_ADMIN_LOGIN_LIMIT=5
THROTTLE_ADMIN_LOGIN_TTL_MS=300000
THROTTLE_PROMO_LIMIT=20
THROTTLE_PROMO_TTL_MS=60000
# Admin broadcasts: scheduled-send poll (0 = off) and users per batch
BROADCAST_WORKER_INTERVAL_MS=30000
BROADCAST_BATCH_SIZE=500
REPORT_MAX_RANGE_DAYS=366

# ─── MongoDB (source of record) ─────────────────────────────────────────────
# Local: mongodb://127.0.0.1:27017   Atlas: mongodb+srv://user:pass@cluster/...
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=tirvona_ride
MONGODB_MIN_POOL_SIZE=1
MONGODB_MAX_POOL_SIZE=20
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000

# ─── Redis (deferred) ───────────────────────────────────────────────────────
# Not used by Phase 3: realtime runs on MongoDB + a single Socket.IO node.
# Leave empty. It becomes required when the Redis adapter / presence arrive.
REDIS_URL=
REDIS_KEY_PREFIX=tirvona-ride:

# ─── Signup OTP over WhatsApp (docs/auth/whatsapp-otp.md) ───────────────────
# Meta WhatsApp Cloud API, backend only — never put these in the app.
#   meta → real WhatsApp messages (default when WHATSAPP_ACCESS_TOKEN is set)
#   log  → codes printed to the API log (development only; refused in production)
WHATSAPP_PROVIDER=
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v23.0
# WhatsApp Manager → API Setup: the numeric "Phone number ID" of the existing
# Tirvona sender (not the phone number itself) and the WABA id.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Permanent System User token with whatsapp_business_messaging.
WHATSAPP_ACCESS_TOKEN=
# Approved AUTHENTICATION template (category Authentication, copy-code button).
WHATSAPP_OTP_TEMPLATE_NAME=tirvona_signup_otp
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en
# true for copy-code / one-tap templates (the code is also the button parameter).
WHATSAPP_OTP_TEMPLATE_CODE_BUTTON=true
WHATSAPP_TIMEOUT_MS=10000
# SOS: message the rider's/driver's emergency contacts on WhatsApp with a map
# pin and a live-tracking link (docs/safety/sos-whatsapp.md). Needs two
# approved templates; the update template is optional (empty = first alert only).
SOS_CONTACT_WHATSAPP_ENABLED=true
WHATSAPP_SOS_TEMPLATE_NAME=tirvona_sos_alert
WHATSAPP_SOS_UPDATE_TEMPLATE_NAME=
WHATSAPP_SOS_TEMPLATE_LANGUAGE=en
# Newer positions go to the contacts at most this often, at most this many times.
SOS_CONTACT_UPDATE_MIN_SECONDS=120
SOS_CONTACT_UPDATE_MAX=8
SOS_CONTACT_RETRY_DELAY_MS=1500
# SOS microphone recording (docs/safety/sos-audio.md): the phone uploads audio
# chunks while an SOS is open; admin and the contacts' tracking page play them.
SOS_AUDIO_ENABLED=true
SOS_AUDIO_RETENTION_DAYS=90
SOS_AUDIO_MAX_SECONDS=14400
# Code lifetime — keep equal to the template's "code expires in" minutes.
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Per phone number: at most N codes per window (survives form re-submits).
OTP_MAX_SENDS_PER_WINDOW=5
OTP_SEND_WINDOW_MINUTES=60
# HMAC key for stored code hashes; required (32+ chars) in production.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
OTP_HASH_SECRET=
# How long a submitted sign-up waits for its code (resends extend it).
SIGNUP_PENDING_TTL_MINUTES=30
# Forgot password: how long a verified reset code lets the user choose a new password.
PASSWORD_RESET_TOKEN_TTL_MINUTES=10

# ─── JWT (used from Phase 1) ────────────────────────────────────────────────
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=tirvona-ride-api
JWT_AUDIENCE=tirvona-ride-clients

# ─── Ride booking (Phase 2) ─────────────────────────────────────────────────
# Business day for "today" counts on driver/admin dashboards.
APP_TIME_ZONE=Asia/Kolkata
# ── Road routing (docs/routes/README.md) ──
# Google Routes API: road distance/duration (fares, ETAs) and the path the
# apps draw. Server-side key "TIRVONA SERVER ROUTES KEY", restricted to the
# Routes API only (+ the server's IP). Never the Android Maps key.
#   google    → Routes API with cache, circuit breaker and straight-line fallback
#   haversine → straight-line estimates only (no Google calls)
# Default: google when GOOGLE_ROUTES_API_KEY is set, otherwise haversine.
ROUTES_PROVIDER=
GOOGLE_ROUTES_API_KEY=
# DRIVE or TWO_WHEELER.
ROUTES_TRAVEL_MODE=DRIVE
# true = live-traffic durations (Routes "Advanced" SKU, costs more).
ROUTES_TRAFFIC_AWARE=false
ROUTES_TIMEOUT_MS=4000
# One Google call per trip within this window (estimate → book).
ROUTES_CACHE_TTL_SECONDS=900
ROUTES_CACHE_MAX_ENTRIES=5000
# After this many straight failures, skip Google for the cooldown.
ROUTES_FAILURE_THRESHOLD=3
ROUTES_FAILURE_COOLDOWN_SECONDS=60
# Live driver route (GET /rides/:id/route): recomputed at most every N
# seconds, or once the driver moved this many metres.
ROUTES_LIVE_REFRESH_SECONDS=90
ROUTES_LIVE_REFRESH_METERS=300

# Straight-line (Haversine) fallback estimate.
# Duration = distance × factor ÷ average speed. Estimates only, never an ETA.
ROUTE_AVERAGE_SPEED_KMPH=22
ROUTE_DISTANCE_FACTOR=1
# How long a booking keeps searching before NO_DRIVER_AVAILABLE.
RIDE_SEARCH_TIMEOUT_SECONDS=120
# How long an assigned driver has to accept before the ride is re-matched.
RIDE_ASSIGNMENT_TIMEOUT_SECONDS=30
# Start-of-trip OTP: lifetime and wrong-attempt limit before it rotates.
RIDE_OTP_TTL_MINUTES=15
RIDE_OTP_MAX_ATTEMPTS=5
# End-of-trip OTP (docs/end-otp/README.md)
RIDE_END_OTP_ENFORCED=true
RIDE_END_OVERRIDE_WAIT_SECONDS=120
RIDE_END_FAR_RADIUS_METERS=500

# ─── Matching ───────────────────────────────────────────────────────────────
# Trip distance limits (per ride type), the matching radius and the nearby-drivers
# radius are set in the admin panel (Configuration → Ride limits), not here.
# Max free cars shown on the rider Home map (positions rounded to ~100 m)
NEARBY_DRIVERS_LIMIT=12
# Safety-net re-match / timeout sweep. 0 disables it.
MATCHING_SWEEP_INTERVAL_MS=5000
# Phase 3: per-ride deadline timers + re-match the moment a driver is free.
MATCHING_REACTIVE_DISPATCH=true

# ─── Realtime (Phase 3, Socket.IO namespace /realtime) ──────────────────────
REALTIME_PING_INTERVAL_MS=20000
REALTIME_PING_TIMEOUT_MS=20000
# Reconnects within this window get their rooms + missed events back.
REALTIME_RECOVERY_WINDOW_MS=120000

# ─── Driver location (Phase 3) ──────────────────────────────────────────────
# A driver whose stored location is older than this is not matchable.
# (Replaces MATCHING_DRIVER_HEARTBEAT_SECONDS, which is still honoured.)
DRIVER_LOCATION_STALE_SECONDS=60
# Every fix is relayed live; MongoDB is written at most this often, or sooner
# after a real move. Must be ≤ half of DRIVER_LOCATION_STALE_SECONDS.
DRIVER_LOCATION_PERSIST_INTERVAL_SECONDS=15
DRIVER_LOCATION_PERSIST_DISTANCE_METERS=75
# Server-side floor between two accepted fixes from one driver.
DRIVER_LOCATION_MIN_INTERVAL_MS=1000
DRIVER_LOCATION_MAX_ACCURACY_METERS=150
# Buffered fixes older than this are not relayed.
DRIVER_LOCATION_MAX_FIX_AGE_SECONDS=30
# "Driver is arriving" fires once within this distance of the pickup.
DRIVER_ARRIVING_RADIUS_METERS=500
# One trip-trail checkpoint at most this often (never every ping). The trail
# is also the trip meter for the final fare, so keep it ≤ 20 s.
RIDE_CHECKPOINT_INTERVAL_SECONDS=15

# Circuits (docs/circuit/README.md)
# Driver must be within this many metres of a stop to mark it arrived (0 = do not check; no GPS fix = allowed).
CIRCUIT_STOP_ARRIVAL_RADIUS_METERS=1000
# How often usage (distance) is measured and 30/10-minute and distance warnings are sent. 0 disables.
CIRCUIT_MONITOR_INTERVAL_MS=30000
# The pickup may be at most this far (straight line) from the first stop of a circuit.
CIRCUIT_MAX_PICKUP_DISTANCE_KM=60

# ─── Final fare (Razorpay integration v2) ───────────────────────────────────
# actual = server-timed trip duration + GPS-trail distance (booked distance when
# the trail is unreliable); booked = the booked route, exactly like the estimate.
FINAL_FARE_MODE=actual
# Customer protection: final fare ≤ estimate × this (0 = no cap).
FINAL_FARE_MAX_ESTIMATE_MULTIPLIER=1.5
# A trail with a longer gap between fixes is not trusted for distance.
TRIP_METER_MAX_GAP_SECONDS=120

# ─── Payments — Razorpay (Phase 4) ──────────────────────────────────────────
# Settings files by NODE_ENV (real env vars always win):
#   development → .env.local, then .env      test → .env.test
#   production  → .env.production, then .env
# Use TEST keys (rzp_test_…) here. Live keys (rzp_live_…) are refused unless
# NODE_ENV=production. Dashboard → Account & Settings → API Keys (Test Mode).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → Add: URL https://<api-host>/api/v1/payments/webhook/razorpay
# Events: payment.authorized, payment.captured, payment.failed, order.paid,
#         refund.created, refund.processed, refund.failed
# (The Phase 4 URL /api/v1/payments/webhook still works.)
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1
RAZORPAY_TIMEOUT_MS=10000
PAYMENT_BRAND_NAME=Tirvona Rides
# Retries re-use the open Razorpay order for this long.
PAYMENT_ORDER_REUSE_MINUTES=60
# Background sync with Razorpay (stuck PROCESSING, missing earnings). 0 = off.
PAYMENT_RECONCILE_INTERVAL_MS=60000
PAYMENT_PROCESSING_STALE_SECONDS=60
# Razorpay accepts refunds for 6 months after capture.
PAYMENT_REFUND_WINDOW_DAYS=180
# Reconcile yesterday against Razorpay once a day, after this local hour.
PAYMENT_DAILY_RECONCILIATION=true
PAYMENT_DAILY_RECONCILIATION_HOUR=3
# Longest window an admin reconciliation run may cover.
PAYMENT_RECONCILIATION_MAX_DAYS=31

# ─── Driver earnings (Phase 4) ──────────────────────────────────────────────
# Seeds commission version 1 on first boot only; then admins own it.
DEFAULT_COMMISSION_PERCENT=20
# Settlement window before an earning is AVAILABLE for payout. 0 = immediately.
EARNINGS_HOLD_HOURS=0

# ─── Notifications, ratings, safety (Phase 5) ───────────────────────────────
# Where this API is reachable from phones/the internet (share-ride links).
# Required (HTTPS) in production.
PUBLIC_BASE_URL=http://localhost:5100
# Public legal pages (/api/v1/legal/privacy|terms|delete-account) that Google Play
# and the app link to. SUPPORT_EMAIL is required in production.
LEGAL_ENTITY_NAME=Tirvona
SUPPORT_EMAIL=
SUPPORT_PHONE=
# File storage (KYC documents, profile photos): MongoDB GridFS. docs/storage/README.md
STORAGE_PROVIDER=gridfs
STORAGE_GRIDFS_BUCKET=tirvonaFiles
# Firebase Cloud Messaging (HTTP v1). Firebase console → Project settings →
# Service accounts → Generate new private key. Either paste the whole JSON
# base64-encoded, or the three fields. Unset = push off, in-app only.
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the \n escapes on one line: "-----BEGIN PRIVATE KEY-----\nMIIE…\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=
FCM_TIMEOUT_MS=10000
DEVICE_TOKENS_MAX_PER_USER=10
# A paid ride can be rated this many days after completion.
RATING_WINDOW_DAYS=30
EMERGENCY_CONTACTS_MAX=5
# SOS stays available this long after the ride ends (incidents at drop-off).
SOS_POST_RIDE_GRACE_MINUTES=30
# Share links: <base>/<token>. Default: this API's own read-only page.
SHARE_RIDE_LINK_BASE_URL=
SHARE_RIDE_MAX_HOURS=12
SHARE_RIDE_GRACE_MINUTES=30

# ─── Place search (pickup/destination autocomplete, current location) ──────
# The app never calls a maps provider directly: /api/v1/places/* proxies,
# caches and rate-limits every lookup, so no map key ships in the app.
#   osm       → FREE, no key (default). Photon for search-as-you-type
#               ("noida sec" → Noida Sector 18/62…) and reverse geocoding,
#               with Nominatim stepping in when Photon is down. Works
#               anywhere in India, ranked around the rider's GPS position.
#   photon    → Photon only.
#   nominatim → Nominatim only. Whole words only (no "sec 6" matching) and
#               ~1 request/s on the public server: not for search boxes.
#   google    → Places API (New) + Geocoding API (recommended for production).
#               Paid beyond Google's monthly free usage. Needs
#               GOOGLE_MAPS_API_KEY: a server key restricted to those two APIs.
#   none      → only the curated Braj landmarks are searchable.
# Default: google when GOOGLE_MAPS_API_KEY is set, otherwise osm.
PLACES_PROVIDER=
GOOGLE_MAPS_API_KEY=
# PLACES_PROVIDER=google only: when Google fails (outage, quota, key
# rejected) use the free OSM pair (osm) or only the curated list (none).
PLACES_FALLBACK=osm
# Skip Google for the cooldown after this many straight failures (or at once
# on a key/permission error).
PLACES_FAILURE_THRESHOLD=3
PLACES_FAILURE_COOLDOWN_SECONDS=60
# Public Photon (fair use). For real traffic self-host it (Docker image +
# India extract, see docs/places/README.md) and set the spacing to 0.
PHOTON_BASE_URL=https://photon.komoot.io
PHOTON_MIN_INTERVAL_MS=200
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Required by the public Nominatim usage policy (sent as email + User-Agent).
NOMINATIM_CONTACT_EMAIL=
# Minimum spacing between Nominatim calls. 0 for a self-hosted instance.
NOMINATIM_MIN_INTERVAL_MS=1000
PLACES_COUNTRY_CODES=in
# Results near here rank first (Vrindavan–Mathura). Not a hard boundary.
PLACES_BIAS_LATITUDE=27.5406
PLACES_BIAS_LONGITUDE=77.6708
PLACES_BIAS_RADIUS_KM=50
# Riders farther than this from every Braj landmark (e.g. testers in Noida)
# see no "Popular in Braj" list, and local results rank first.
PLACES_FEATURED_RADIUS_KM=75
PLACES_TIMEOUT_MS=5000
# In-memory answer cache (per API process).
PLACES_CACHE_TTL_SECONDS=21600
PLACES_CACHE_MAX_ENTRIES=5000
